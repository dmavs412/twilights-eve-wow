                    <Size>
                        <AbsDimension x="30" y="30"/>
                    </Size>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture name="$parentFrame" file="Interface\Benilla\fishing\slot" setAllPoints="true"/>
                <Texture name="$parentPip1" file="Interface\Benilla\fishing\pip_off" hidden="true">
                    <Size>
                        <AbsDimension x="6" y="6"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOM">
                            <Offset>
                                <AbsDimension x="-9" y="3"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <Texture name="$parentPip2" file="Interface\Benilla\fishing\pip_off" hidden="true">
                    <Size>
                        <AbsDimension x="6" y="6"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOM">
                            <Offset>
                                <AbsDimension x="0" y="3"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <Texture name="$parentPip3" file="Interface\Benilla\fishing\pip_off" hidden="true">
                    <Size>
                        <AbsDimension x="6" y="6"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOM">
                            <Offset>
                                <AbsDimension x="9" y="3"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <FontString name="$parentLabel" inherits="GameFontNormalSmall">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                this:RegisterForClicks("LeftButtonUp", "RightButtonUp")
            </OnLoad>
            <OnClick>
                BenillaFishingJournalSlot_OnClick(arg1)
            </OnClick>
            <OnReceiveDrag>
                BenillaFishingJournalSlot_OnClick("LeftButton")
            </OnReceiveDrag>
            <OnEnter>
                BenillaFishingJournalSlot_OnEnter()
            </OnEnter>
            <OnLeave>
                BenillaFishingJournalSlot_OnLeave()
            </OnLeave>
        </Scripts>
    </Button>

    <!-- A page or close button in the placeholder button art. -->
