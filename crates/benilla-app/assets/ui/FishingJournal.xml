<Ui>
    <!--
        The Fishing Journal (spec #323), opened by TOGGLEFISHINGJOURNAL (J) or /journal. At the top
        the bait slot: it shows the chosen bait's icon and how many the bags hold, a bait item
        dropped on it from the bags calls SetFishingBait, and a right-click clears it. Under it one
        zone at a time, paged with the arrows: the zone's name, a grid of fish slots (an icon and
        three pips for caught, perfect and legendary, or a dark silhouette and "???"), a divider
        and four Legends slots.

        The app pushes the realm's journal; the frames read only GetFishingJournal(),
        GetFishingJournalZone(i) and GetFishingLegends(), and FISHING_JOURNAL_UPDATE says when to
        repaint. The art is `Interface\Benilla\fishing\*`, painted RGBA `.tga` files.
    -->
    <Script><![CDATA[
        BENILLA_JOURNAL_ART = "Interface\\Benilla\\fishing\\"
        BENILLA_JOURNAL_FISH_SLOTS = 12
        BENILLA_JOURNAL_PER_ROW = 6
        BENILLA_JOURNAL_LEGEND_SLOTS = 4
        BENILLA_JOURNAL_SLOT = 40
        BENILLA_JOURNAL_HINT = "You have heard a rumour of a legendary fish in these waters."

        BINDING_HEADER_BENILLAFISHING = "Fishing"
        BINDING_NAME_TOGGLEFISHINGJOURNAL = "Toggle Fishing Journal"

        -- The count of `item` the bags hold.
        function BenillaFishingJournal_ItemCount(item)
            local total = 0
            if not item then
                return 0
            end
            for bag = 0, 4 do
                for slot = 1, GetContainerNumSlots(bag) do
                    local link = GetContainerItemLink(bag, slot)
                    if link then
                        local _, _, id = string.find(link, "item:(%d+)")
                        if tonumber(id) == item then
                            local _, count = GetContainerItemInfo(bag, slot)
                            total = total + (count or 1)
                        end
                    end
                end
            end
            return total
        end

        -- An item's icon, or the placeholder fish when the client does not know it.
        function BenillaFishingJournal_Icon(item)
            if item then
                local _, _, _, _, _, _, _, _, texture = GetItemInfo(item)
                if texture then
                    return texture
                end
            end
            return BENILLA_JOURNAL_ART .. "fish"
        end

        function BenillaFishingJournal_Pips(slot, caught, perfect, legendary)
            local name = slot:GetName()
            local on = { caught, perfect, legendary }
            for i = 1, 3 do
                local pip = getglobal(name .. "Pip" .. i)
                pip:SetTexture(BENILLA_JOURNAL_ART .. (on[i] and "pip_on" or "pip_off"))
                pip:Show()
            end
        end

        function BenillaFishingJournal_HidePips(slot)
            local name = slot:GetName()
            for i = 1, 3 do
                getglobal(name .. "Pip" .. i):Hide()
            end
        end

        -- A slot's face: `state` is "caught" (the item's icon), "silhouette" (a dark fish and
        -- "???"), "dark" (a dark slot) or "empty" (nothing).
        function BenillaFishingJournal_Face(slot, state, item)
            local name = slot:GetName()
            local icon = getglobal(name .. "Icon")
            local label = getglobal(name .. "Label")
            slot.item = item
            slot.caught = (state == "caught")
            slot.state = state
            label:SetText("")
            if state == "caught" then
                icon:SetTexture(BenillaFishingJournal_Icon(item))
                icon:SetVertexColor(1, 1, 1)
                icon:Show()
            elseif state == "silhouette" then
                icon:SetTexture(BENILLA_JOURNAL_ART .. "fish")
                icon:SetVertexColor(0.15, 0.15, 0.15)
                icon:Show()
                label:SetText("???")
            else
                icon:Hide()
            end
            if state ~= "caught" then
                BenillaFishingJournal_HidePips(slot)
            end
            slot:Show()
        end

        function BenillaFishingJournal_PaintBait()
            local bait = GetFishingJournal()
            local slot = BenillaFishingJournalBait
            BenillaFishingJournal_Face(slot, bait and "caught" or "empty", bait)
            slot.kind = "bait"
            BenillaFishingJournalBaitCount:SetText(bait and BenillaFishingJournal_ItemCount(bait) or "")
            BenillaFishingJournalBaitHint:SetText(bait and "" or "Drop bait here")
        end

        -- The Legendary Fish of `zoneName`: a flat list of item, hintFound, caught triples.
        function BenillaFishingJournal_ZoneLegends(zoneName)
            local all = { GetFishingLegends() }
            local mine = {}
            for i = 1, table.getn(all), 4 do
                if all[i + 1] == zoneName then
                    table.insert(mine, { all[i], all[i + 2], all[i + 3] })
                end
            end
            return mine, all
        end

        function BenillaFishingJournal_PaintFish(zone, legends)
            local caughtLegend = {}
            for i = 1, table.getn(legends), 4 do
                if legends[i + 3] then
                    caughtLegend[legends[i]] = true
                end
            end
            for n = 1, BENILLA_JOURNAL_FISH_SLOTS do
                local slot = getglobal("BenillaFishingJournalFish" .. n)
                slot.kind = "fish"
                local item = zone[2 * n]
                local best = zone[2 * n + 1]
                if not item then
                    slot:Hide()
                elseif best and best > 0 then
                    BenillaFishingJournal_Face(slot, "caught", item)
                    BenillaFishingJournal_Pips(slot, true, best >= 2, caughtLegend[item])
                else
                    BenillaFishingJournal_Face(slot, "silhouette", item)
                end
            end
        end

        function BenillaFishingJournal_PaintLegends(zoneName)
            local mine = BenillaFishingJournal_ZoneLegends(zoneName)
            for n = 1, BENILLA_JOURNAL_LEGEND_SLOTS do
                local slot = getglobal("BenillaFishingJournalLegend" .. n)
                slot.kind = "legend"
                local row = mine[n]
                slot.hint = nil
                if row and row[3] then
                    BenillaFishingJournal_Face(slot, "caught", row[1])
                elseif row and row[2] then
                    BenillaFishingJournal_Face(slot, "dark", row[1])
                    slot.hint = BENILLA_JOURNAL_HINT
                    getglobal(slot:GetName() .. "Label"):SetText("?")
                else
                    BenillaFishingJournal_Face(slot, "dark", nil)
                end
            end
        end

        function BenillaFishingJournal_Paint()
            local frame = BenillaFishingJournal
            local _, count = GetFishingJournal()
            local page = frame.page or 1
            page = math.max(1, math.min(page, math.max(count, 1)))
            frame.page = page
            BenillaFishingJournal_PaintBait()
            local zone = { GetFishingJournalZone(page) }
            local zoneName = zone[1] or ""
            -- With the name gone, slot n reads zone[2n] and zone[2n + 1].
            zone[1] = false
            BenillaFishingJournalZoneName:SetText(zoneName)
            BenillaFishingJournalPage:SetText(count > 0 and (page .. " / " .. count) or "")
            if count > 1 then
                BenillaFishingJournalPrev:Show()
                BenillaFishingJournalNext:Show()
            else
                BenillaFishingJournalPrev:Hide()
                BenillaFishingJournalNext:Hide()
            end
            local _, all = BenillaFishingJournal_ZoneLegends(zoneName)
            BenillaFishingJournal_PaintFish(zone, all)
            BenillaFishingJournal_PaintLegends(zoneName)
        end

        function BenillaFishingJournal_Turn(step)
            local frame = BenillaFishingJournal
            frame.page = (frame.page or 1) + step
            BenillaFishingJournal_Paint()
        end

        function BenillaFishingJournal_Toggle()
            if BenillaFishingJournal:IsShown() then
                BenillaFishingJournal:Hide()
            else
                BenillaFishingJournal:Show()
            end
        end

        -- A bait item dropped from the bags becomes the bait.
        function BenillaFishingJournalBait_Receive()
            local item = BenillaGetCursorItem()
            if item then
                SetFishingBait(item)
                ClearCursor()
            end
        end

        function BenillaFishingJournalSlot_OnClick(button)
            if this ~= BenillaFishingJournalBait then
                return
            end
            if button == "RightButton" then
                SetFishingBait(nil)
            else
                BenillaFishingJournalBait_Receive()
            end
        end

        function BenillaFishingJournalSlot_OnEnter()
            local slot = this
            if not GameTooltip then
                return
            end
            GameTooltip:SetOwner(slot, "ANCHOR_RIGHT")
            if slot.caught and slot.item then
                GameTooltip:SetHyperlink("item:" .. slot.item .. ":0:0:0")
            elseif slot.kind == "bait" then
                GameTooltip:SetText("Bait")
                GameTooltip:AddLine("Drop bait from your bags here. Right-click to clear.", 1, 1, 1, 1)
            elseif slot.hint then
                GameTooltip:SetText("Legendary fish")
                GameTooltip:AddLine(slot.hint, 1, 1, 1, 1)
            else
                GameTooltip:SetText("???")
            end
            GameTooltip:Show()
        end

        function BenillaFishingJournalSlot_OnLeave()
            if GameTooltip then
                GameTooltip:Hide()
            end
        end

        function BenillaFishingJournal_OnEvent()
            if BenillaFishingJournal:IsShown() then
                BenillaFishingJournal_Paint()
            end
        end

        SLASH_BENILLAJOURNAL1 = "/journal"
        SlashCmdList["BENILLAJOURNAL"] = function()
            BenillaFishingJournal_Toggle()
        end
    ]]></Script>

    <!-- One square slot: the dark well, the icon, the frame, three pips and a label. -->
    <Button name="BenillaFishingJournalSlotTemplate" virtual="true">
        <Size>
            <AbsDimension x="40" y="40"/>
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentWell" file="Interface\Benilla\fishing\slot_bg" setAllPoints="true"/>
            </Layer>
            <Layer level="ARTWORK">
