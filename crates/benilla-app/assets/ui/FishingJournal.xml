<Ui>
    <!--
        The Fishing Journal (spec #323), opened by TOGGLEFISHINGJOURNAL (J) or /journal. At the top
        three slots: Pole, Lure and Bait. The bait slot shows the chosen bait's icon and how many
        the bags hold, a bait item dropped on it from the bags calls SetFishingBait, and a
        right-click clears it. A pole or lure dropped on its slot calls SetFishingGear, a
        right-click calls ClearFishingGear, and the Lure slot shows its durability. Under them one
        zone at a time, paged with the arrows: the zone's name, a grid of fish slots (an icon and
        three pips for caught, perfect and legendary, or a dark silhouette and "???"), a divider
        and four Legends slots. A click on a caught fish swaps the zone view for that fish's page
        (the Fish Page spec #368): its places, then a line per reveal tier. Back returns.

        The app pushes the realm's journal; the frames read only GetFishingJournal(),
        GetFishingJournalZone(i), GetFishingLegends(), GetFishingGear(), GetFishPage(item),
        GetFishPagePlace(item, i) and GetFishPageHabitat(item, i), and FISHING_JOURNAL_UPDATE says
        when to repaint. The art is `Interface\Benilla\fishing\*`, painted RGBA `.tga` files.
    -->
    <Script><![CDATA[
        BENILLA_JOURNAL_ART = "Interface\\Benilla\\fishing\\"
        BENILLA_JOURNAL_FISH_SLOTS = 12
        BENILLA_JOURNAL_PER_ROW = 6
        BENILLA_JOURNAL_LEGEND_SLOTS = 4
        BENILLA_JOURNAL_SLOT = 40
        BENILLA_JOURNAL_PAGE_LINES = 14
        -- The catch counts that unlock a page's three tiers: `[journal] reveal_at` in fish.toml.
        BENILLA_JOURNAL_REVEAL_AT = { 5, 10, 25 }
        BENILLA_JOURNAL_QUALITY = {
            [0] = { 0.62, 0.62, 0.62 },
            [1] = { 1, 1, 1 },
            [2] = { 0.12, 1, 0 },
            [3] = { 0, 0.44, 0.87 },
            [4] = { 0.64, 0.21, 0.93 },
            [5] = { 1, 0.5, 0 },
        }
        -- Everything the zone view shows besides the fish and Legends slots.
        BENILLA_JOURNAL_GRID = {
            "BenillaFishingJournalZoneName", "BenillaFishingJournalPage",
            "BenillaFishingJournalPrev", "BenillaFishingJournalNext",
            "BenillaFishingJournalDivider", "BenillaFishingJournalLegendsTitle",
        }
        BENILLA_JOURNAL_HINT = "You have heard a rumour of a legendary fish in these waters."

        BINDING_HEADER_BENILLAFISHING = "Fishing"
        BINDING_NAME_TOGGLEFISHINGJOURNAL = "Toggle Fishing Journal"

        -- The count of `item` the bags hold.
        function BenillaFishingJournal_ItemCount(item)
            local total = 0
            if not item then
                return 0
            end
            for bag = 0, 4 do
                for slot = 1, GetContainerNumSlots(bag) do
                    local link = GetContainerItemLink(bag, slot)
                    if link then
                        local _, _, id = string.find(link, "item:(%d+)")
                        if tonumber(id) == item then
                            local _, count = GetContainerItemInfo(bag, slot)
                            total = total + (count or 1)
                        end
                    end
                end
            end
            return total
        end

        -- An item's icon, or the placeholder fish when the client does not know it.
        function BenillaFishingJournal_Icon(item)
            if item then
                local _, _, _, _, _, _, _, _, texture = GetItemInfo(item)
                if texture then
                    return texture
                end
            end
            return BENILLA_JOURNAL_ART .. "fish"
        end

        function BenillaFishingJournal_Pips(slot, caught, perfect, legendary)
            local name = slot:GetName()
            local on = { caught, perfect, legendary }
            for i = 1, 3 do
                local pip = getglobal(name .. "Pip" .. i)
                pip:SetTexture(BENILLA_JOURNAL_ART .. (on[i] and "pip_on" or "pip_off"))
                pip:Show()
            end
        end

        function BenillaFishingJournal_HidePips(slot)
            local name = slot:GetName()
            for i = 1, 3 do
                getglobal(name .. "Pip" .. i):Hide()
            end
        end

        -- A slot's face: `state` is "caught" (the item's icon), "silhouette" (a dark fish and
        -- "???"), "dark" (a dark slot) or "empty" (nothing).
        function BenillaFishingJournal_Face(slot, state, item)
            local name = slot:GetName()
            local icon = getglobal(name .. "Icon")
            local label = getglobal(name .. "Label")
            slot.item = item
            slot.caught = (state == "caught")
            slot.state = state
            label:SetText("")
            if state == "caught" then
                icon:SetTexture(BenillaFishingJournal_Icon(item))
                icon:SetVertexColor(1, 1, 1)
                icon:Show()
            elseif state == "silhouette" then
                icon:SetTexture(BENILLA_JOURNAL_ART .. "fish")
                icon:SetVertexColor(0.15, 0.15, 0.15)
                icon:Show()
                label:SetText("???")
            else
                icon:Hide()
            end
            if state ~= "caught" then
                BenillaFishingJournal_HidePips(slot)
            end
            slot:Show()
        end

        function BenillaFishingJournal_PaintBait()
            local bait = GetFishingJournal()
            local slot = BenillaFishingJournalBait
            BenillaFishingJournal_Face(slot, bait and "caught" or "empty", bait)
            slot.kind = "bait"
            BenillaFishingJournalBaitCount:SetText(bait and BenillaFishingJournal_ItemCount(bait) or "")
            BenillaFishingJournalBaitHint:SetText(bait and "" or "Drop bait here")
        end

        -- The Pole and Lure slots. The Lure shows its durability as "14/20".
        function BenillaFishingJournal_PaintGear()
            local pole, lure, durability, max = GetFishingGear()
            local slot = BenillaFishingJournalPole
            BenillaFishingJournal_Face(slot, pole and "caught" or "empty", pole)
            slot.kind = "pole"
            BenillaFishingJournalPoleHint:SetText(pole and "" or "Drop a pole here")
            slot = BenillaFishingJournalLure
            BenillaFishingJournal_Face(slot, lure and "caught" or "empty", lure)
            slot.kind = "lure"
            slot.durability = lure and (durability .. " / " .. max) or nil
            BenillaFishingJournalLureCount:SetText(lure and (durability .. "/" .. max) or "")
            BenillaFishingJournalLureHint:SetText(lure and "" or "Drop a lure here")
        end

        -- The Legendary Fish of `zoneName`: a flat list of item, hintFound, caught triples.
        function BenillaFishingJournal_ZoneLegends(zoneName)
            local all = { GetFishingLegends() }
            local mine = {}
            for i = 1, table.getn(all), 4 do
                if all[i + 1] == zoneName then
                    table.insert(mine, { all[i], all[i + 2], all[i + 3] })
                end
            end
            return mine, all
        end

        function BenillaFishingJournal_PaintFish(zone, legends)
            local caughtLegend = {}
            for i = 1, table.getn(legends), 4 do
                if legends[i + 3] then
                    caughtLegend[legends[i]] = true
                end
            end
            for n = 1, BENILLA_JOURNAL_FISH_SLOTS do
                local slot = getglobal("BenillaFishingJournalFish" .. n)
                slot.kind = "fish"
                local item = zone[2 * n]
                local best = zone[2 * n + 1]
                if not item then
                    slot:Hide()
                elseif best and best > 0 then
                    BenillaFishingJournal_Face(slot, "caught", item)
                    BenillaFishingJournal_Pips(slot, true, best >= 2, caughtLegend[item])
                else
                    BenillaFishingJournal_Face(slot, "silhouette", item)
                end
            end
        end

        function BenillaFishingJournal_PaintLegends(zoneName)
            local mine = BenillaFishingJournal_ZoneLegends(zoneName)
            for n = 1, BENILLA_JOURNAL_LEGEND_SLOTS do
                local slot = getglobal("BenillaFishingJournalLegend" .. n)
                slot.kind = "legend"
                local row = mine[n]
                slot.hint = nil
                if row and row[3] then
                    BenillaFishingJournal_Face(slot, "caught", row[1])
                elseif row and row[2] then
                    BenillaFishingJournal_Face(slot, "dark", row[1])
                    slot.hint = BENILLA_JOURNAL_HINT
                    getglobal(slot:GetName() .. "Label"):SetText("?")
                else
                    BenillaFishingJournal_Face(slot, "dark", nil)
                end
            end
        end

        -- Show or hide the zone view's own widgets; the fish and Legends slots follow their paint.
        function BenillaFishingJournal_ShowGrid(on)
            for i = 1, table.getn(BENILLA_JOURNAL_GRID) do
                local widget = getglobal(BENILLA_JOURNAL_GRID[i])
                if on then
                    widget:Show()
                else
                    widget:Hide()
                end
            end
            if not on then
                for n = 1, BENILLA_JOURNAL_FISH_SLOTS do
                    getglobal("BenillaFishingJournalFish" .. n):Hide()
                end
                for n = 1, BENILLA_JOURNAL_LEGEND_SLOTS do
                    getglobal("BenillaFishingJournalLegend" .. n):Hide()
                end
            end
        end

        -- "Water, Zone" for a named Fishing Water, else just the zone.
        function BenillaFishingJournal_Place(zone, water)
            if water and water ~= "" then
                return water .. ", " .. zone
            end
            return zone
        end

        function BenillaFishingJournal_ItemName(item)
            local name = item and GetItemInfo(item)
            return name or "an unknown item"
        end

        -- The page's text lines for `item`: its places, then one line per tier.
        function BenillaFishingJournal_PageLines(item)
            local caught, perfect, revealed, nextReveal, places, lives, kinds, peakFrom, peakTo,
                bait = GetFishPage(item)
            local lines = {}
            for i = 1, places do
                local zone, water, count = GetFishPagePlace(item, i)
                table.insert(lines, BenillaFishingJournal_Place(zone, water) .. ": " .. count)
            end
            local locked = 0
            for tier = 1, 3 do
                if tier > revealed then
                    local need = (locked == 0) and nextReveal or BENILLA_JOURNAL_REVEAL_AT[tier]
                    locked = locked + 1
                    table.insert(lines, "??? (catch " .. need .. " to learn)")
                elseif tier == 1 then
                    local homes = {}
                    for i = 1, lives do
                        local zone, water = GetFishPageHabitat(item, i)
                        table.insert(homes, BenillaFishingJournal_Place(zone, water))
                    end
                    table.insert(lines, "Lives in: " .. (lives > 0 and table.concat(homes, "; ") or "anywhere"))
                elseif tier == 2 then
                    local water = (kinds == "") and "any" or string.gsub(kinds, ",", ", ")
                    table.insert(lines, "Water: " .. water)
                    if peakFrom then
                        table.insert(lines, string.format("Bites most: %d:00 to %d:00", peakFrom, peakTo))
                    else
                        table.insert(lines, "Bites at any hour")
                    end
                else
                    table.insert(lines, "Favourite bait: " .. (bait and BenillaFishingJournal_ItemName(bait) or "none"))
                end
            end
            return lines, caught, perfect
        end

        function BenillaFishingJournal_PaintPage(item)
            local lines, caught, perfect = BenillaFishingJournal_PageLines(item)
            local name, _, quality, _, _, _, _, _, texture = GetItemInfo(item)
            local color = BENILLA_JOURNAL_QUALITY[quality or 1] or BENILLA_JOURNAL_QUALITY[1]
            BenillaFishingJournal_ShowGrid(false)
            BenillaFishingJournalPageIcon:SetTexture(BenillaFishingJournal_Icon(item))
            BenillaFishingJournalPageIcon:Show()
            BenillaFishingJournalPageName:SetText(name or "Unknown fish")
            BenillaFishingJournalPageName:SetTextColor(color[1], color[2], color[3])
            BenillaFishingJournalPageName:Show()
            BenillaFishingJournalPageCaught:SetText("Caught " .. caught .. ", perfect " .. perfect)
            BenillaFishingJournalPageCaught:Show()
            for n = 1, BENILLA_JOURNAL_PAGE_LINES do
                local line = getglobal("BenillaFishingJournalLine" .. n)
                line:SetText(lines[n] or "")
                line:Show()
            end
            BenillaFishingJournalBack:Show()
        end

        function BenillaFishingJournal_HidePage()
            BenillaFishingJournalPageIcon:Hide()
            BenillaFishingJournalPageName:Hide()
            BenillaFishingJournalPageCaught:Hide()
            for n = 1, BENILLA_JOURNAL_PAGE_LINES do
                getglobal("BenillaFishingJournalLine" .. n):Hide()
            end
            BenillaFishingJournalBack:Hide()
        end

        function BenillaFishingJournal_OpenPage(item)
            if GetFishPage(item) then
                BenillaFishingJournal.fish = item
                BenillaFishingJournal_Paint()
            end
        end

        function BenillaFishingJournal_Back()
            BenillaFishingJournal.fish = nil
            BenillaFishingJournal_Paint()
        end

        function BenillaFishingJournal_Paint()
            local frame = BenillaFishingJournal
            BenillaFishingJournal_PaintBait()
            BenillaFishingJournal_PaintGear()
            if frame.fish and GetFishPage(frame.fish) then
                BenillaFishingJournal_PaintPage(frame.fish)
                return
            end
            frame.fish = nil
            BenillaFishingJournal_HidePage()
            BenillaFishingJournal_ShowGrid(true)
            local _, count = GetFishingJournal()
            local page = frame.page or 1
            page = math.max(1, math.min(page, math.max(count, 1)))
            frame.page = page
            local zone = { GetFishingJournalZone(page) }
            local zoneName = zone[1] or ""
            -- With the name gone, slot n reads zone[2n] and zone[2n + 1].
            zone[1] = false
            BenillaFishingJournalZoneName:SetText(zoneName)
            BenillaFishingJournalPage:SetText(count > 0 and (page .. " / " .. count) or "")
            if count > 1 then
                BenillaFishingJournalPrev:Show()
                BenillaFishingJournalNext:Show()
            else
                BenillaFishingJournalPrev:Hide()
                BenillaFishingJournalNext:Hide()
            end
            local _, all = BenillaFishingJournal_ZoneLegends(zoneName)
            BenillaFishingJournal_PaintFish(zone, all)
            BenillaFishingJournal_PaintLegends(zoneName)
        end

        function BenillaFishingJournal_Turn(step)
            local frame = BenillaFishingJournal
            frame.page = (frame.page or 1) + step
            BenillaFishingJournal_Paint()
        end

        function BenillaFishingJournal_Toggle()
            if BenillaFishingJournal:IsShown() then
                BenillaFishingJournal:Hide()
            else
                BenillaFishingJournal:Show()
            end
        end

        -- A bait item dropped from the bags becomes the bait.
        function BenillaFishingJournalBait_Receive()
            local item = BenillaGetCursorItem()
            if item then
                SetFishingBait(item)
                ClearCursor()
            end
        end

        -- A pole or lure dropped from the bags goes into its slot; the realm refuses any other item.
        function BenillaFishingJournalGear_Receive(which)
            local bag, slot = BenillaGetCursorItemPos()
            if bag then
                SetFishingGear(which, bag, slot)
                ClearCursor()
            end
        end

        function BenillaFishingJournalSlot_OnClick(button)
            local slot = this
            if slot == BenillaFishingJournalBait then
                if button == "RightButton" then
                    SetFishingBait(nil)
                else
                    BenillaFishingJournalBait_Receive()
                end
            elseif slot == BenillaFishingJournalPole or slot == BenillaFishingJournalLure then
                local which = (slot == BenillaFishingJournalPole) and "POLE" or "LURE"
                if button == "RightButton" then
                    ClearFishingGear(which)
                else
                    BenillaFishingJournalGear_Receive(which)
                end
            elseif slot.kind == "fish" and slot.caught and button ~= "RightButton" then
                BenillaFishingJournal_OpenPage(slot.item)
            end
        end

        function BenillaFishingJournalSlot_OnEnter()
            local slot = this
            if not GameTooltip then
                return
            end
            GameTooltip:SetOwner(slot, "ANCHOR_RIGHT")
            if slot.caught and slot.item then
                GameTooltip:SetHyperlink("item:" .. slot.item .. ":0:0:0")
                if slot.kind == "lure" and slot.durability then
                    GameTooltip:AddLine("Durability " .. slot.durability, 1, 1, 1)
                end
            elseif slot.kind == "pole" then
                GameTooltip:SetText("Fishing pole")
                GameTooltip:AddLine("Drop a pole from your bags here. Right-click to clear.", 1, 1, 1, 1)
            elseif slot.kind == "lure" then
                GameTooltip:SetText("Lure")
                GameTooltip:AddLine("Drop a lure from your bags here. Right-click to clear.", 1, 1, 1, 1)
            elseif slot.kind == "bait" then
                GameTooltip:SetText("Bait")
                GameTooltip:AddLine("Drop bait from your bags here. Right-click to clear.", 1, 1, 1, 1)
            elseif slot.hint then
                GameTooltip:SetText("Legendary fish")
                GameTooltip:AddLine(slot.hint, 1, 1, 1, 1)
            else
                GameTooltip:SetText("???")
            end
            GameTooltip:Show()
        end

        function BenillaFishingJournalSlot_OnLeave()
            if GameTooltip then
                GameTooltip:Hide()
            end
        end

        function BenillaFishingJournal_OnEvent()
            if BenillaFishingJournal:IsShown() then
                BenillaFishingJournal_Paint()
            end
        end

        SLASH_BENILLAJOURNAL1 = "/journal"
        SlashCmdList["BENILLAJOURNAL"] = function()
            BenillaFishingJournal_Toggle()
        end
    ]]></Script>

