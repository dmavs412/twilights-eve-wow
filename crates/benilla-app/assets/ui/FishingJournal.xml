            </Button>
            <Button name="BenillaFishingJournalFish11" inherits="BenillaFishingJournalSlotTemplate" id="11">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="222" y="-160"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalFish12" inherits="BenillaFishingJournalSlotTemplate" id="12">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="272" y="-160"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalLegend1" inherits="BenillaFishingJournalSlotTemplate" id="1">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="72" y="-258"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalLegend2" inherits="BenillaFishingJournalSlotTemplate" id="2">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="122" y="-258"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalLegend3" inherits="BenillaFishingJournalSlotTemplate" id="3">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="172" y="-258"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalLegend4" inherits="BenillaFishingJournalSlotTemplate" id="4">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="222" y="-258"/></Offset></Anchor></Anchors>
