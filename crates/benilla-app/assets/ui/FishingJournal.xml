            <AbsDimension x="24" y="24"/>
        </Size>
        <ButtonText name="$parentText"/>
        <NormalTexture file="Interface\Benilla\fishing\button_normal"/>
        <PushedTexture file="Interface\Benilla\fishing\button_pushed"/>
        <HighlightTexture file="Interface\Benilla\fishing\button_hover" alphaMode="ADD"/>
        <DisabledTexture file="Interface\Benilla\fishing\button_disabled"/>
        <NormalFont inherits="GameFontNormal"/>
        <HighlightFont inherits="GameFontHighlight"/>
        <DisabledFont inherits="GameFontDisable"/>
    </Button>

