            </Button>
            <Button name="BenillaFishingJournalFish2" inherits="BenillaFishingJournalSlotTemplate" id="2">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="72" y="-112"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalFish3" inherits="BenillaFishingJournalSlotTemplate" id="3">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="122" y="-112"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalFish4" inherits="BenillaFishingJournalSlotTemplate" id="4">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="172" y="-112"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalFish5" inherits="BenillaFishingJournalSlotTemplate" id="5">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="222" y="-112"/></Offset></Anchor></Anchors>
            </Button>
            <Button name="BenillaFishingJournalFish6" inherits="BenillaFishingJournalSlotTemplate" id="6">
                <Anchors><Anchor point="TOPLEFT"><Offset><AbsDimension x="272" y="-112"/></Offset></Anchor></Anchors>
