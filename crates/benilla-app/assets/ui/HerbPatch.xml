        <Scripts>
            <OnClick>BenillaHerbTile_OnClick()</OnClick>
            <OnEnter>BenillaHerbTile_OnEnter()</OnEnter>
            <OnLeave>BenillaHerbTile_OnLeave()</OnLeave>
        </Scripts>
    </Button>

